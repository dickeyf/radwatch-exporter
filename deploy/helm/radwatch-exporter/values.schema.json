{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository"
      ]
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "$ref": "#/definitions/stringMap"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logLevel": {
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "staleAfter": {
          "type": "string",
          "pattern": "^(0|([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+)$"
        },
        "debugRequests": {
          "type": "boolean"
        },
        "allowedCIDRs": {
          "$ref": "#/definitions/stringList"
        },
        "trustedProxies": {
          "$ref": "#/definitions/stringList"
        },
        "deviceNames": {
          "$ref": "#/definitions/stringMap"
        },
        "gmcmap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/[^?# ]*$"
            },
            "allowedGIDs": {
              "$ref": "#/definitions/stringList"
            },
            "allowedAIDs": {
              "$ref": "#/definitions/stringList"
            },
            "responseStatus": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "responseBody": {
              "type": "string"
            },
            "forwardURL": {
              "type": "string"
            }
          }
        }
      }
    },
    "extraEnv": {
      "type": "array"
    },
    "podAnnotations": {
      "$ref": "#/definitions/stringMap"
    },
    "podLabels": {
      "$ref": "#/definitions/stringMap"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "metricsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "labels": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "ingestService": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "externalTrafficPolicy": {
          "enum": [
            "Local",
            "Cluster"
          ]
        },
        "loadBalancerIP": {
          "type": "string"
        },
        "loadBalancerClass": {
          "type": "string"
        },
        "loadBalancerSourceRanges": {
          "$ref": "#/definitions/stringList"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "labels": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "pattern": "^(/[^?# ]*)?$"
        },
        "pathType": {
          "enum": [
            "Exact",
            "Prefix",
            "ImplementationSpecific"
          ]
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            }
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string",
          "pattern": "^([0-9]+(ms|s|m|h))*$"
        },
        "scrapeTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(ms|s|m|h))*$"
        },
        "labels": {
          "$ref": "#/definitions/stringMap"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "relabelings": {
          "type": "array"
        },
        "metricRelabelings": {
          "type": "array"
        }
      }
    },
    "prometheusRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labels": {
          "$ref": "#/definitions/stringMap"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "alertLabels": {
          "$ref": "#/definitions/stringMap"
        },
        "deviceSilent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "seconds": {
              "type": "integer",
              "minimum": 60
            },
            "for": {
              "type": "string",
              "pattern": "^([0-9]+(ms|s|m|h|d))+$"
            },
            "severity": {
              "enum": [
                "info",
                "warning",
                "critical"
              ]
            }
          }
        },
        "doseRate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "warning": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "sievertsPerHour": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "for": {
                  "type": "string",
                  "pattern": "^([0-9]+(ms|s|m|h|d))+$"
                }
              }
            },
            "critical": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "sievertsPerHour": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "for": {
                  "type": "string",
                  "pattern": "^([0-9]+(ms|s|m|h|d))+$"
                }
              }
            }
          }
        }
      }
    },
    "grafanaDashboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string"
        },
        "labels": {
          "$ref": "#/definitions/stringMap"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingestFromAllowedCIDRs": {
          "type": "boolean"
        },
        "ingestFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "metricsFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "egress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "nodeSelector": {
      "$ref": "#/definitions/stringMap"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    }
  }
}
